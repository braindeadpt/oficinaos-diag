<Window x:Class="OficinaDiag.InsuranceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Relatório para seguradora" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#0a0f0a" Foreground="#33ff33"
        FontFamily="Cascadia Mono, Consolas">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#7fd77f"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0d1f0d"/>
            <Setter Property="Foreground" Value="#33ff33"/>
            <Setter Property="BorderBrush" Value="#1d4a1d"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="#33ff33"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#0d1f0d"/>
            <Setter Property="Foreground" Value="#33ff33"/>
            <Setter Property="BorderBrush" Value="#1d4a1d"/>
            <Setter Property="Padding" Value="14,6"/>
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
        <StackPanel Margin="20">
            <TextBlock FontSize="14" Foreground="#33ff33" Margin="0,0,0,4"
                       Text="RELATÓRIO PARA SEGURADORA"/>
            <TextBlock TextWrapping="Wrap" Margin="0,0,0,4"
                       Text="Documento formal (A4) com o estado do equipamento — para o cliente entregar à seguradora. Imprime ou grava em PDF no browser."/>

            <TextBlock Text="segurado (nome do cliente) *"/>
            <TextBox x:Name="InsuredNameBox" MaxLength="200"/>

            <TextBlock Text="seguradora"/>
            <TextBox x:Name="InsurerBox" MaxLength="200"/>

            <TextBlock Text="nº apólice / processo de sinistro"/>
            <TextBox x:Name="PolicyNoBox" MaxLength="100"/>

            <TextBlock Text="dano reportado *"/>
            <TextBox x:Name="DamageBox" MaxLength="2000" AcceptsReturn="True"
                     Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="reparação proposta"/>
            <TextBox x:Name="RepairBox" MaxLength="500"
                     ToolTip="ex.: Substituição de conjunto ecrã + junta de vedação"/>

            <TextBlock Text="custo estimado (€)"/>
            <TextBox x:Name="CostBox" MaxLength="50" ToolTip="ex.: 89,90"/>

            <TextBlock Text="técnico responsável"/>
            <TextBox x:Name="TechnicianBox" MaxLength="200"/>

            <TextBlock Text="── dados da loja (ficam guardados) ──" Margin="0,18,0,6"/>

            <TextBlock Text="nome da loja *"/>
            <TextBox x:Name="ShopNameBox" MaxLength="200"/>

            <TextBlock Text="NIF da loja"/>
            <TextBox x:Name="ShopNifBox" MaxLength="20"/>

            <TextBlock Text="telefone da loja"/>
            <TextBox x:Name="ShopPhoneBox" MaxLength="50"/>

            <TextBlock Text="morada da loja"/>
            <TextBox x:Name="ShopAddressBox" MaxLength="300"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="[ GERAR ]" IsDefault="True" Click="Generate_Click"/>
                <Button Content="[ cancelar ]" IsCancel="True" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
