<Window x:Class="OficinaDiag.InsuranceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Insurer report" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource TermButton}"/>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="640">
        <StackPanel Margin="20">
            <TextBlock x:Name="HeaderText" FontSize="14" Foreground="{DynamicResource FgBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="DescText" TextWrapping="Wrap" Margin="0,0,0,4"/>

            <TextBlock x:Name="InsuredLabel"/>
            <TextBox x:Name="InsuredNameBox" MaxLength="200"/>

            <TextBlock x:Name="InsurerLabel"/>
            <TextBox x:Name="InsurerBox" MaxLength="200"/>

            <TextBlock x:Name="PolicyLabel"/>
            <TextBox x:Name="PolicyNoBox" MaxLength="100"/>

            <TextBlock x:Name="DamageLabel"/>
            <TextBox x:Name="DamageBox" MaxLength="2000" AcceptsReturn="True"
                     Height="60" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <TextBlock x:Name="RepairLabel"/>
            <TextBox x:Name="RepairBox" MaxLength="500"/>

            <TextBlock x:Name="CostLabel"/>
            <TextBox x:Name="CostBox" MaxLength="50"/>

            <TextBlock x:Name="TechLabel"/>
            <TextBox x:Name="TechnicianBox" MaxLength="200"/>

            <TextBlock x:Name="ShopSecLabel" Margin="0,18,0,6"/>

            <TextBlock x:Name="ShopNameLabel"/>
            <TextBox x:Name="ShopNameBox" MaxLength="200"/>

            <TextBlock x:Name="ShopNifLabel"/>
            <TextBox x:Name="ShopNifBox" MaxLength="20"/>

            <TextBlock x:Name="ShopPhoneLabel"/>
            <TextBox x:Name="ShopPhoneBox" MaxLength="50"/>

            <TextBlock x:Name="ShopAddrLabel"/>
            <TextBox x:Name="ShopAddressBox" MaxLength="300"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="GenerateBtn" IsDefault="True" Click="Generate_Click"/>
                <Button x:Name="CancelBtn" IsCancel="True" Margin="10,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
