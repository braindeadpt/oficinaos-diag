<Window x:Class="OficinaDiag.AppManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apps" Width="940" Height="660" MinWidth="660" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource TermCombo}"/>
        <Style TargetType="Button" BasedOn="{StaticResource TermButton}"/>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderText" FontSize="14" Foreground="{DynamicResource FgBrush}"/>
            <TextBlock x:Name="DescText" TextWrapping="Wrap" Margin="0,4,0,0"/>
            <TextBlock x:Name="DeviceText" Margin="0,4,0,0" FontFamily="{DynamicResource MonoFont}"/>
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,10,0,8">
            <Button x:Name="RefreshBtn" Click="Refresh_Click"/>
            <ComboBox x:Name="FilterBox" Width="150" Margin="10,0,0,0" SelectionChanged="Filter_Changed"/>
            <ComboBox x:Name="SortBox" Width="130" Margin="10,0,0,0" SelectionChanged="Sort_Changed"/>
            <TextBox x:Name="SearchBox" Width="240" Margin="10,0,0,0"
                     TextChanged="Search_Changed"/>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="16,0,0,0"/>
        </WrapPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.2*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="1.6*"/>
                    <ColumnDefinition Width="1.2*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ColPackage" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource DimBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="1" x:Name="ColKind" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource DimBrush}"/>
                <TextBlock Grid.Column="2" x:Name="ColState" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource DimBrush}"/>
                <TextBlock Grid.Column="3" x:Name="ColInstaller" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource DimBrush}" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="4" x:Name="ColProtection" FontWeight="SemiBold" FontSize="11"
                           Foreground="{DynamicResource DimBrush}" TextTrimming="CharacterEllipsis"/>
            </Grid>
            <ListBox Grid.Row="1" x:Name="AppsList" SelectionChanged="AppsList_Changed">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2.2*"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="1.6*"/>
                                <ColumnDefinition Width="1.2*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Package}" FontFamily="{DynamicResource MonoFont}"
                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Package}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Kind}"/>
                            <TextBlock Grid.Column="2" Text="{Binding State}"/>
                            <TextBlock Grid.Column="3" Text="{Binding Installer}" TextTrimming="CharacterEllipsis"
                                       FontFamily="{DynamicResource MonoFont}"/>
                            <TextBlock Grid.Column="4" Text="{Binding Protection}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <StackPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="DetailsText" TextWrapping="Wrap"/>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="UninstallBtn" Click="Uninstall_Click" IsEnabled="False"/>
                <Button x:Name="DisableBtn" Click="Disable_Click" IsEnabled="False" Margin="8,0,0,0"/>
                <Button x:Name="EnableBtn" Click="Enable_Click" IsEnabled="False" Margin="8,0,0,0"/>
                <Button x:Name="RestoreBtn" Click="Restore_Click" IsEnabled="False" Margin="8,0,0,0"/>
                <Button x:Name="ForceStopBtn" Click="ForceStop_Click" IsEnabled="False" Margin="8,0,0,0"/>
                <Button x:Name="UndoBtn" Click="Undo_Click" IsEnabled="False" Margin="16,0,0,0"/>
            </WrapPanel>
        </StackPanel>

        <TextBox Grid.Row="4" x:Name="LogText" Margin="0,10,0,0" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="CloseBtn" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
