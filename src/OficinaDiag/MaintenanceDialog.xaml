<Window x:Class="OficinaDiag.MaintenanceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Limpeza" Width="640" Height="680"
        MinWidth="520" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="{DynamicResource UiFont}">
    <!-- DockPanel como o ChecklistDialog: as ações ficam ancoradas em baixo
         e o conteúdo rola — os botões nunca saem do ecrã. -->
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="Margin" Value="0,4,0,2"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Margin" Value="0,3,0,3"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource TermButton}"/>
    </Window.Resources>

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeaderText" FontSize="14" Foreground="{DynamicResource FgBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="DescText" TextWrapping="Wrap" Margin="0,0,0,4"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="RunBtn" IsDefault="True" Click="Run_Click"/>
            <Button x:Name="SaveBtn" IsDefault="True" Click="Save_Click" Visibility="Collapsed"/>
            <Button x:Name="MeasureAgainBtn" Click="MeasureAgain_Click" Visibility="Collapsed"/>
            <Button x:Name="CancelBtn" IsCancel="True" Margin="10,0,0,0"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" ClipToBounds="True">
            <StackPanel>
                <!-- medições do "antes" — atualizadas por MEDIR DE NOVO -->
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" Padding="10,8" Margin="0,0,0,10">
                    <TextBlock x:Name="SnapText" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                               Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap"/>
                </Border>

                <TextBlock x:Name="AppsLabel" TextWrapping="Wrap"/>
                <!-- SelectionMode Extended: Ctrl/Shift escolhem várias de uma vez -->
                <ListBox x:Name="AppsList" SelectionMode="Extended" MaxHeight="150"
                         Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource FgBrush}"
                         BorderBrush="{DynamicResource LineBrush}" Margin="0,0,0,8"/>

                <StackPanel>
                    <CheckBox x:Name="ChkTrim" Content=""/>
                    <CheckBox x:Name="ChkClearCache" Content=""/>
                    <CheckBox x:Name="ChkForceStop" Content=""/>
                    <CheckBox x:Name="ChkKillAll" Content=""/>
                    <CheckBox x:Name="ChkAnimOff" Content=""/>
                    <CheckBox x:Name="ChkAnimRestore" Content=""/>
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkBatteryOpt" Content="" VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,10">
                    <TextBlock x:Name="SaverLabel" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <ComboBox x:Name="SaverCombo" Width="180" Style="{DynamicResource TermCombo}"/>
                </StackPanel>

                <!-- resultado do antes/depois — visível só depois de CORRER -->
                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed" Margin="0,6,0,0">
                    <TextBlock x:Name="ResultsLabel"/>
                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource LineBrush}"
                            BorderThickness="1" Padding="10,8">
                        <TextBlock x:Name="ResultsText" FontFamily="{DynamicResource MonoFont}" FontSize="12"
                                   Foreground="{DynamicResource FgBrush}" TextWrapping="Wrap"/>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
