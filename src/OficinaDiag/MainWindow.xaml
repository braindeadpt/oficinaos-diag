<Window x:Class="OficinaDiag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OFICINA-OS // DIAG" Height="640" Width="960"
        Background="#050a05" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="TermButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#33ff33"/>
            <Setter Property="BorderBrush" Value="#33ff33"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#123312"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#2a5a2a"/>
                                <Setter Property="BorderBrush" Value="#2a5a2a"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <!-- scanlines: CRT phosphor overlay -->
        <Rectangle IsHitTestVisible="False" Opacity="0.07">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Black"><GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,4,2"/>
                        </GeometryDrawing.Geometry></GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Border Grid.Row="0" BorderBrush="#1d4a1d" BorderThickness="0,0,0,1" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Consolas" FontSize="18" FontWeight="Bold" Foreground="#33ff33"
                               Text="█▓▒░ OFICINA-OS // DIAG v0.1"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="20,0,0,0"
                               FontFamily="Consolas" FontSize="12" Foreground="#7fd77f"
                               Text="a vigiar USB…"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- console -->
                <Border BorderBrush="#1d4a1d" BorderThickness="0,0,1,0" Margin="0">
                    <TextBox x:Name="Console" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="Transparent" Foreground="#33ff33" BorderThickness="0"
                             FontFamily="Consolas" FontSize="12.5" Padding="14,10"
                             Text="" />
                </Border>

                <!-- results -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock FontFamily="Consolas" Foreground="#7fd77f" FontSize="11"
                                   Text="── RESULTADOS ────────────────" Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ResultsList" FontFamily="Consolas" FontSize="12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusTag}}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        <TextBlock Grid.Column="1" Foreground="#bfe8bf" TextWrapping="Wrap">
                                            <Run Text="{Binding Key}"/><Run Text="  "/>
                                            <Run Text="{Binding Display}" Foreground="#7fd77f"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- actions -->
            <Border Grid.Row="2" BorderBrush="#1d4a1d" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource TermButton}" x:Name="ScanButton"
                            Click="Scan_Click">[ SCAN ]</Button>
                    <Button Style="{StaticResource TermButton}" x:Name="TestButton"
                            Click="Test_Click" IsEnabled="False">[ ECRÃ+TOQUE ]</Button>
                    <Button Style="{StaticResource TermButton}" x:Name="ExportButton"
                            Click="Export_Click" IsEnabled="False">[ EXPORTAR ]</Button>
                    <Button Style="{StaticResource TermButton}" x:Name="SendButton"
                            Click="Send_Click" IsEnabled="False">[ →LOJA (PRO) ]</Button>
                    <Button Style="{StaticResource TermButton}" x:Name="AiButton"
                            Click="Ai_Click" IsEnabled="False">[ IA (PRO) ]</Button>
                    <Button Style="{StaticResource TermButton}" x:Name="ConfigButton"
                            Click="Config_Click" Margin="20,0,0,0">[ ⚙ CLOUD ]</Button>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
