<Window x:Class="OficinaDiag.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OficinaDiag"
        Title="OFICINA-OS // DIAG" Height="640" Width="960"
        MinWidth="700" MinHeight="480"
        Background="{DynamicResource BgBrush}" WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:StatusTagConverter x:Key="StatusTag"/>
        <local:StatusBrushConverter x:Key="StatusBrush"/>
    </Window.Resources>

    <Grid>
        <!-- scanlines: CRT phosphor overlay — só o tema terminal as expõe -->
        <Rectangle IsHitTestVisible="False" Opacity="{DynamicResource ScanlineOpacity}">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Black"><GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,4,2"/>
                        </GeometryDrawing.Geometry></GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource HeaderBgBrush}" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HeaderTitle" FontFamily="{DynamicResource MonoFont}" FontSize="18"
                               FontWeight="Bold" Foreground="{DynamicResource HeaderFgBrush}"/>
                    <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="20,0,0,0"
                               FontFamily="{DynamicResource UiFont}" FontSize="12"
                               Foreground="{DynamicResource HeaderDimBrush}"/>
                    <!-- instrumento vivo: corrente/tensão/temp/carga enquanto há dispositivo -->
                    <TextBlock x:Name="TelemetryText" VerticalAlignment="Center" Margin="20,0,0,0"
                               FontFamily="{DynamicResource MonoFont}" FontSize="12"
                               Foreground="{DynamicResource HeaderDimBrush}" Text=""/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <!-- console -->
                <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Margin="0">
                    <TextBox x:Name="Console" IsReadOnly="True" AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Background="{DynamicResource PanelBrush}" BorderThickness="0"
                             Foreground="{DynamicResource FgBrush}" CaretBrush="{DynamicResource FgBrush}"
                             FontFamily="{DynamicResource MonoFont}" FontSize="12.5" Padding="14,10"
                             Text="" />
                </Border>

                <!-- results -->
                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <TextBlock x:Name="ResultsHeader" FontFamily="{DynamicResource MonoFont}"
                                   Foreground="{DynamicResource DimBrush}" FontSize="11"
                                   Margin="0,0,0,8"/>
                        <ItemsControl x:Name="ResultsList" FontFamily="{DynamicResource MonoFont}" FontSize="12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="62"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusTag}}"
                                                   Foreground="{Binding Status, Converter={StaticResource StatusBrush}}"/>
                                        <TextBlock Grid.Column="1" Foreground="{DynamicResource TextBrush}" TextWrapping="Wrap">
                                            <Run Text="{Binding Key}"/><Run Text="  "/>
                                            <Run Text="{Binding Display}" Foreground="{DynamicResource DimBrush}"/>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- actions -->
            <Border Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                <!-- WrapPanel: os botões que não couberem passam para baixo em vez de cortar -->
                <WrapPanel>
                    <Button Style="{DynamicResource TermButton}" x:Name="ScanButton"
                            Click="Scan_Click"/>
                    <Button Style="{DynamicResource TermButton}" x:Name="BenchButton"
                            Click="Bench_Click" IsEnabled="False"/>
                    <Button Style="{DynamicResource TermButton}" x:Name="TestButton"
                            Click="Test_Click" IsEnabled="False"/>
                    <Button Style="{DynamicResource TermButton}" x:Name="ExportButton"
                            Click="Export_Click" IsEnabled="False"/>
                    <Button Style="{DynamicResource TermButton}" x:Name="SendButton"
                            Click="Send_Click" IsEnabled="False"/>
                    <Button Style="{DynamicResource TermButton}" x:Name="AiButton"
                            Click="Ai_Click" IsEnabled="False"/>
                    <Button Style="{DynamicResource TermButton}" x:Name="InsuranceButton"
                            Click="Insurance_Click" IsEnabled="False"/>
                    <Button Style="{DynamicResource TermButton}" x:Name="UpdateButton"
                            Click="Update_Click" Visibility="Collapsed"
                            Foreground="{DynamicResource WarnBrush}"
                            BorderBrush="{DynamicResource WarnBrush}"/>
                    <Button Style="{DynamicResource TermButton}" x:Name="LogButton"
                            Click="LogSend_Click" Margin="20,0,0,0"/>
                    <Button Style="{DynamicResource TermButton}" x:Name="ConfigButton"
                            Click="Config_Click"/>
                </WrapPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
