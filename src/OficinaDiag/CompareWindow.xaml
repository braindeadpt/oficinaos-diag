<Window x:Class="OficinaDiag.CompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OficinaDiag"
        Title="Antes / depois" Width="780" Height="560"
        MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="{DynamicResource UiFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="130"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="HeaderText" FontSize="14" Foreground="{DynamicResource FgBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="DescText" TextWrapping="Wrap" Foreground="{DynamicResource DimBrush}"
                       Margin="0,0,0,4"/>
        </StackPanel>

        <!-- scans anteriores deste serial -->
        <ListBox x:Name="ScanList" Grid.Row="1" Margin="0,6,0,10"
                 FontFamily="{DynamicResource MonoFont}" FontSize="12"
                 Background="{DynamicResource PanelBrush}"
                 Foreground="{DynamicResource FgBrush}"
                 BorderBrush="{DynamicResource LineBrush}"
                 SelectionChanged="ScanList_Changed"/>

        <!-- diff antes → agora -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="ColCheck" FontFamily="{DynamicResource MonoFont}" FontSize="11"
                           Foreground="{DynamicResource DimBrush}"/>
                <TextBlock x:Name="ColBefore" Grid.Column="1" FontFamily="{DynamicResource MonoFont}"
                           FontSize="11" Foreground="{DynamicResource DimBrush}"/>
                <TextBlock x:Name="ColNow" Grid.Column="2" FontFamily="{DynamicResource MonoFont}"
                           FontSize="11" Foreground="{DynamicResource DimBrush}"/>
            </Grid>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="DiffList" FontFamily="{DynamicResource MonoFont}" FontSize="12">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Key}" Foreground="{DynamicResource TextBrush}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Before}"
                                           Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="2" Text="{Binding Now}"
                                           Foreground="{Binding Brush}" TextWrapping="Wrap"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Style="{DynamicResource TermButton}" x:Name="CloseBtn" IsCancel="True" Click="Close_Click"/>
        </StackPanel>
    </Grid>
</Window>
