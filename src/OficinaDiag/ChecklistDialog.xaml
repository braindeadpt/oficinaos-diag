<Window x:Class="OficinaDiag.ChecklistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Checklist" Width="560" Height="620"
        <!-- 480: abaixo disto as linhas fixas (notas, fotos, ações) já não
             cabem e o DockPanel empurra-as para fora do cliente. -->
        MinWidth="480" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="Margin" Value="0,6,0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource TermButton}"/>
    </Window.Resources>

    <!--
        DockPanel, não Grid com linha `*`: aqui as ações são ancoradas em baixo
        primeiro e o checklist fica com o que sobrar, por isso os botões nunca
        saem do ecrã e as linhas de itens nunca pintam por cima das notas. Com
        o Grid, a soma das linhas Auto passava da janela e o APLICAR ficava
        cortado a meio no tamanho por omissão (visto nas capturas do CI).
    -->
    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="HeaderText" FontSize="14" Foreground="{DynamicResource FgBrush}"
                       Margin="0,0,0,4"/>
            <TextBlock x:Name="DescText" TextWrapping="Wrap" Margin="0,0,0,4"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="ApplyBtn" IsDefault="True" Click="Apply_Click"/>
            <Button x:Name="CancelBtn" IsCancel="True" Margin="10,0,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="PhotoBtn" Click="Photo_Click"/>
            <TextBlock x:Name="PhotoCount" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
            <TextBlock x:Name="NotesLabel"/>
            <!-- 2000 = limite de `notes` na Cloud (IntakeRules.NotesMaxLength) -->
            <TextBox x:Name="NotesBox" AcceptsReturn="True" Height="56" MaxLength="2000"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            <!-- o texto é um TextBlock com Wrap (ver code-behind): Content de
                 string não parte e saía cortado à direita -->
            <CheckBox x:Name="SaleBox" Margin="0,8,0,0"/>
        </StackPanel>

        <!-- os itens são gerados no code-behind a partir de Grader.ChecklistItems -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" ClipToBounds="True">
            <StackPanel x:Name="ItemsPanel"/>
        </ScrollViewer>
    </DockPanel>
</Window>
