<Window x:Class="OficinaDiag.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}"/>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource TermButton}"/>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="HeaderText" FontSize="14" Foreground="{DynamicResource FgBrush}"
                   Margin="0,0,0,4"/>

        <TextBlock x:Name="LangLabel"/>
        <RadioButton x:Name="LangPt" Content="Português"/>
        <RadioButton x:Name="LangEn" Content="English"/>

        <TextBlock x:Name="ThemeLabel"/>
        <RadioButton x:Name="ThemeTerminal"/>
        <RadioButton x:Name="ThemeWin95"/>
        <RadioButton x:Name="ThemeFluent"/>

        <TextBlock x:Name="CloudLabel"/>
        <TextBox x:Name="CloudBox" MaxLength="300"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveBtn" IsDefault="True" Click="Save_Click"/>
            <Button x:Name="CancelBtn" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
