<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Moderno — alinhado com o design system «Parafuso» do site (rebrand
         2026-11): neutros dos tokens.css, acento ciano do produto Diag
         (oos-product-diag), semânticas success/warning/danger partilhadas.
         Contraste AA: acento #0E7490 sobre branco ≈ 5,5:1; muted #4A5468 ≈ 7:1. -->
    <SolidColorBrush x:Key="BgBrush" Color="#F5F7FB"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FgBrush" Color="#111827"/>
    <SolidColorBrush x:Key="TextBrush" Color="#111827"/>
    <SolidColorBrush x:Key="DimBrush" Color="#4A5468"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#8792A6"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D6DDE8"/>
    <!-- hover: o «soft» do acento Diag (oos-product-diag-soft) -->
    <SolidColorBrush x:Key="HoverBrush" Color="#DDF4F8"/>
    <!-- O desativado tem de se ler como secundário sem desaparecer:
         o muted dos tokens fica em ~7:1 sobre branco. -->
    <SolidColorBrush x:Key="DisabledBrush" Color="#4A5468"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#0E7490"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#A15C00"/>
    <SolidColorBrush x:Key="FailBrush" Color="#C42424"/>
    <SolidColorBrush x:Key="PassBrush" Color="#15803D"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderFgBrush" Color="#0E7490"/>
    <SolidColorBrush x:Key="HeaderDimBrush" Color="#4A5468"/>
    <!-- Tipografia do design system: Inter (UI) e JetBrains Mono, embutidas
         como recursos (OFL) — os fallbacks cobrem instalação falhada. -->
    <FontFamily x:Key="UiFont">/OficinaDiag;component/Assets/Fonts/#Inter Variable, Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">/OficinaDiag;component/Assets/Fonts/#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="ScanlineOpacity">0</sys:Double>

    <Style x:Key="TermButton" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="BorderBrush" Value="#D6DDE8"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#BFEBF2"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <!-- só a cor: subir a espessura empurrava o conteúdo 1px
                             a cada tabulação. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="#EEF2F8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Botões das etapas do pipeline: o ativo é o acento da marca decidido
         pelo estado da etapa (Tag=ativo), nunca pelo foco — o foco do
         teclado é só um sublinhado, para nunca se confundir com seleção. -->
    <Style x:Key="TermStageButton" TargetType="Button" BasedOn="{StaticResource TermButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#BFEBF2"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="FontStyle" Value="Italic"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                            <Setter TargetName="bd" Property="Background" Value="#EEF2F8"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="ativo">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            <Setter Property="Foreground" Value="#FFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Seletor de dispositivos: altura fixa e largura máxima para o header. -->
    <Style x:Key="TermCombo" TargetType="ComboBox">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Height" Value="26"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="MaxWidth" Value="240"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
</ResourceDictionary>
