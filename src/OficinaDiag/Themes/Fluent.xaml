<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Moderno — Fluent claro, cantos redondos, acento azul da marca (#1D4ED8) -->
    <SolidColorBrush x:Key="BgBrush" Color="#F3F3F3"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FgBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1B1B1B"/>
    <SolidColorBrush x:Key="DimBrush" Color="#605E5C"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#8A8886"/>
    <SolidColorBrush x:Key="LineBrush" Color="#E1DFDD"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#E6EDFF"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="#A19F9D"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#986F0B"/>
    <SolidColorBrush x:Key="FailBrush" Color="#C42B1C"/>
    <SolidColorBrush x:Key="PassBrush" Color="#107C10"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderFgBrush" Color="#1D4ED8"/>
    <SolidColorBrush x:Key="HeaderDimBrush" Color="#605E5C"/>
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <sys:Double x:Key="ScanlineOpacity">0</sys:Double>

    <Style x:Key="TermButton" TargetType="Button">
        <Setter Property="Background" Value="#FFFFFF"/>
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="BorderBrush" Value="#D1D1D1"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                            <Setter TargetName="bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="#D9EAE8"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
