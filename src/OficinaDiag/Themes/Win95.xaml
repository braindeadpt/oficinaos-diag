<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Windows 95 — cinza de painel, bevels levantados, Tahoma, faixa navy -->
    <SolidColorBrush x:Key="BgBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="FgBrush" Color="#000000"/>
    <SolidColorBrush x:Key="TextBrush" Color="#000000"/>
    <SolidColorBrush x:Key="DimBrush" Color="#404040"/>
    <SolidColorBrush x:Key="FaintBrush" Color="#808080"/>
    <SolidColorBrush x:Key="LineBrush" Color="#808080"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#C0C0C0"/>
    <SolidColorBrush x:Key="DisabledBrush" Color="#808080"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#000080"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#808000"/>
    <SolidColorBrush x:Key="FailBrush" Color="#FF0000"/>
    <SolidColorBrush x:Key="PassBrush" Color="#008000"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#000080"/>
    <SolidColorBrush x:Key="HeaderFgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderDimBrush" Color="#C0C0C0"/>
    <FontFamily x:Key="UiFont">Tahoma</FontFamily>
    <FontFamily x:Key="MonoFont">Courier New</FontFamily>
    <sys:Double x:Key="ScanlineOpacity">0</sys:Double>

    <!-- bevel 95: branco em cima/esquerda, sombra em baixo/direita; ao carregar inverte -->
    <Style x:Key="TermButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <!-- padrão do bevel: quem personalize Background/BorderBrush no botão
             continua a mandar (o template lê por TemplateBinding) -->
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="BorderBrush" Value="#808080"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="14,5"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Margin" Value="0,0,8,4"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="shadow" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,1,1"
                            Background="{TemplateBinding Background}">
                        <Border x:Name="face" BorderBrush="#FFFFFF" BorderThickness="1,1,0,0"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="face" Property="BorderBrush" Value="#808080"/>
                            <Setter TargetName="shadow" Property="BorderBrush" Value="#FFFFFF"/>
                        </Trigger>
                        <!-- foco: contorno navy no bevel — o 95 não tinha halo, mas
                             sem isto tabular às cegas era o que havia. -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="shadow" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Seletor de dispositivos ao estilo 95: cinza, bevel de 1px, com
         template próprio — só as cores deixava o dropdown e o botão nativos. -->
    <Style x:Key="TermCombo" TargetType="ComboBox">
        <Setter Property="Background" Value="#C0C0C0"/>
        <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
        <Setter Property="BorderBrush" Value="#808080"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,2"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="MinWidth" Value="150"/>
        <Setter Property="MaxWidth" Value="240"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <!-- itens inline, sem x:Key: os três temas têm de definir o mesmo
             conjunto de chaves (há teste para isso) e o Fluent não usa este. -->
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="ComboBoxItem">
                    <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
                    <Setter Property="FontSize" Value="12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBoxItem">
                                <Border x:Name="bd" Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsHighlighted" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="#FFFFFF"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="shadow" BorderBrush="#808080" BorderThickness="0,0,1,1"
                                            Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}">
                                        <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                                            <Path HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,4,0" Data="M 0 0 L 4 4 L 8 0 Z" Fill="#000000"/>
                                        </Border>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="shadow" Property="BorderBrush" Value="#000080"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter Margin="6,0,18,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                               IsOpen="{TemplateBinding IsDropDownOpen}" Focusable="False">
                            <Border Background="#FFFFFF" BorderBrush="#000000" BorderThickness="1"
                                    MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra de scroll com bevel de 95; a nativa destoava do resto.
         Setas a sério (LineUp/LineDown) e zonas de página mais claras que o
         corpo: antes as zonas pintavam o `BgBrush` do tema e não havia seta
         nenhuma, por isso a barra lia-se como um bloco cinzento sem fim.
         Dois templates, um por orientação — com colunas em vez de linhas e as
         setas nos lados — e nenhum `x:Key` novo (os três temas têm de expor o
         mesmo conjunto). -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="#DFDFDF"/>
        <Setter Property="Width" Value="16"/>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="16"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="16"/>
                                </Grid.RowDefinitions>
                                <RepeatButton Grid.Row="0" Command="ScrollBar.LineUpCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="#C0C0C0" BorderBrush="#808080" BorderThickness="0,0,1,1">
                                                <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                                                    <Path Fill="#000000" Data="M 0 0 L 0 0 Z"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                                <Track Grid.Row="1" x:Name="PART_Track" Orientation="Vertical"
                                       IsDirectionReversed="True">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="#DFDFDF"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#808080" Margin="1">
                                                        <Border Background="#C0C0C0" BorderBrush="#FFFFFF" BorderThickness="1,1,0,0"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="#DFDFDF"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                                <RepeatButton Grid.Row="2" Command="ScrollBar.LineDownCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="#C0C0C0" BorderBrush="#808080" BorderThickness="0,0,1,1">
                                                <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                                                    <Path Fill="#000000" Data="M 0 0 L 8 0 L 4 4 Z"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="{TemplateBinding Background}" Height="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                </Grid.ColumnDefinitions>
                                <RepeatButton Grid.Column="0" Command="ScrollBar.LineLeftCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="#C0C0C0" BorderBrush="#808080" BorderThickness="0,0,1,1">
                                                <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                                                    <Path Fill="#000000" Data="M 4 0 L 4 8 L 0 4 Z"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                                <Track Grid.Column="1" x:Name="PART_Track" Orientation="Horizontal">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageLeftCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="#DFDFDF"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb>
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border Background="#808080" Margin="1">
                                                        <Border Background="#C0C0C0" BorderBrush="#FFFFFF" BorderThickness="1,1,0,0"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.PageRightCommand" Focusable="False">
                                            <RepeatButton.Template>
                                                <ControlTemplate TargetType="RepeatButton">
                                                    <Border Background="#DFDFDF"/>
                                                </ControlTemplate>
                                            </RepeatButton.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                                <RepeatButton Grid.Column="2" Command="ScrollBar.LineRightCommand" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="#C0C0C0" BorderBrush="#808080" BorderThickness="0,0,1,1">
                                                <Border BorderBrush="#FFFFFF" BorderThickness="1,1,0,0">
                                                    <Path Fill="#000000" Data="M 0 0 L 0 8 L 4 4 Z"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Border>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Height" Value="16"/>
                <Setter Property="Width" Value="Auto"/>
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
