<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OficinaDiag</AssemblyName>
    <Version>0.3.2</Version>
    <Description>USB phone diagnostics — free local scan, Pro reports via oficinaos-cloud</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>OficinaOS</Product>
    <FileDescription>OficinaOS Diag</FileDescription>
    <Company>Oficina de Sistemas</Company>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <!-- Release: símbolos embutidos no assembly. Sem .pdb solto no pacote
       (não serve ao cliente e expõe caminhos de build) sem perder linhas
       de stack trace; o bin local também deixa de os produzir. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OficinaDiag.Core\OficinaDiag.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- QRCoder fica na app: só a janela do QR o usa. -->
    <PackageReference Include="QRCoder" Version="1.9.0" />
  </ItemGroup>

  <!-- bundled adb, copied to output; Data/models.json + Tests/wwwroot vêm do Core -->
  <ItemGroup>
    <Content Include="..\..\tools\platform-tools\**" LinkBase="tools/platform-tools" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('..\..\tools\platform-tools')" />
    <!-- scrcpy (espelho de ecrã): mesma origem — fetch-tools.ps1, git-ignored,
         layout oficial do zip (scrcpy.exe + DLLs + LICENSE.txt Apache-2.0). -->
    <Content Include="..\..\tools\scrcpy\**" LinkBase="tools/scrcpy" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('..\..\tools\scrcpy')" />
  </ItemGroup>

  <!--
    O iMobileDevice-net copia natives de ~21 RIDs (osx, linux, wasm…) para o
    output mesmo com -r win-x64. Só win-* serve: o resto é peso morto e o
    Defender marca os libirecovery macOS como Exploit:MacOS/LimeRain —
    falso positivo mas alarme real no PC do cliente.
  -->
  <Target Name="StripForeignNativeRuntimes" AfterTargets="Build;Publish">
    <!-- PublishDir está sempre definido mas só existe com publish real;
         testam-se os dois caminhos. `powershell` não existe fora do
         Windows (o CI ubuntu-24.04 falhava com exit 127); em Unix a mesma
         limpeza corre com `find`+`rm`. -->
    <Exec Condition="Exists('$(PublishDir)runtimes') AND '$(OS)' == 'Windows_NT'"
          Command="powershell -NoProfile -Command &quot;Get-ChildItem '$(PublishDir)runtimes' -Directory | Where-Object Name -notlike 'win-*' | Remove-Item -Recurse -Force&quot;" />
    <Exec Condition="Exists('$(PublishDir)runtimes') AND '$(OS)' != 'Windows_NT'"
          Command="find '$(PublishDir)runtimes' -mindepth 1 -maxdepth 1 -type d ! -name 'win-*' -exec rm -rf {} +" />
    <Exec Condition="Exists('$(OutDir)runtimes') AND '$(OS)' == 'Windows_NT'"
          Command="powershell -NoProfile -Command &quot;Get-ChildItem '$(OutDir)runtimes' -Directory | Where-Object Name -notlike 'win-*' | Remove-Item -Recurse -Force&quot;" />
    <Exec Condition="Exists('$(OutDir)runtimes') AND '$(OS)' != 'Windows_NT'"
          Command="find '$(OutDir)runtimes' -mindepth 1 -maxdepth 1 -type d ! -name 'win-*' -exec rm -rf {} +" />
  </Target>

</Project>
