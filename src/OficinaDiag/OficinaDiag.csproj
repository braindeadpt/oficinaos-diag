<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>OficinaDiag</AssemblyName>
    <Version>0.2.1</Version>
    <Description>USB phone diagnostics — free local scan, Pro reports via oficinaos-cloud</Description>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Product>OficinaOS</Product>
    <FileDescription>OficinaOS Diag</FileDescription>
    <Company>Oficina de Sistemas</Company>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OficinaDiag.Core\OficinaDiag.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- QRCoder fica na app: só a janela do QR o usa. -->
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <!-- bundled adb, copied to output; Data/models.json + Tests/wwwroot vêm do Core -->
  <ItemGroup>
    <Content Include="..\..\tools\platform-tools\**" LinkBase="tools/platform-tools" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" Condition="Exists('..\..\tools\platform-tools')" />
  </ItemGroup>

</Project>
