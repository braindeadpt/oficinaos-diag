<Window x:Class="OficinaDiag.BenchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:OficinaDiag"
        Title="OFICINA-OS // BENCH" Height="620" Width="920"
        MinWidth="640" MinHeight="440"
        Background="{DynamicResource BgBrush}" WindowStartupLocation="CenterOwner">
    <Grid>
        <!-- scanlines: CRT phosphor overlay — só o tema terminal as expõe -->
        <Rectangle IsHitTestVisible="False" Opacity="{DynamicResource ScanlineOpacity}">
            <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,4,4" ViewportUnits="Absolute">
                    <DrawingBrush.Drawing>
                        <GeometryDrawing Brush="Black"><GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,4,2"/>
                        </GeometryDrawing.Geometry></GeometryDrawing>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- header -->
            <Border Grid.Row="0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1"
                    Background="{DynamicResource HeaderBgBrush}" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="HeaderText" FontFamily="{DynamicResource MonoFont}" FontSize="16"
                               FontWeight="Bold" Foreground="{DynamicResource HeaderFgBrush}"/>
                    <TextBlock x:Name="DeviceLabel" VerticalAlignment="Center" Margin="20,0,0,0"
                               FontFamily="{DynamicResource UiFont}" FontSize="12"
                               Foreground="{DynamicResource HeaderDimBrush}"/>
                </StackPanel>
            </Border>

            <!-- instrução guiada -->
            <Border Grid.Row="1" Padding="16,8">
                <TextBlock x:Name="Instr" FontFamily="{DynamicResource UiFont}" FontSize="14"
                           Foreground="{DynamicResource WarnBrush}"/>
            </Border>

            <!-- scope -->
            <Border Grid.Row="2" Margin="16,4" BorderBrush="{DynamicResource LineBrush}"
                    BorderThickness="1" Padding="6" Background="{DynamicResource PanelBrush}">
                <Grid>
                    <local:ScopeView x:Name="Scope"/>
                    <TextBlock VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6"
                               FontFamily="{DynamicResource MonoFont}" FontSize="11">
                        <Run Text="— mA" Foreground="{DynamicResource FgBrush}"/><Run Text="   "/>
                        <Run Text="— mV" Foreground="{DynamicResource DimBrush}"/><Run Text="   "/>
                        <Run x:Name="TempLegend" Foreground="{DynamicResource WarnBrush}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- leitura viva -->
            <Border Grid.Row="3" Padding="16,4">
                <TextBlock x:Name="Live" FontFamily="{DynamicResource MonoFont}" FontSize="15"
                           Foreground="{DynamicResource FgBrush}" Text="—"/>
            </Border>

            <!-- veredicto -->
            <Border Grid.Row="4" Padding="16,4">
                <TextBlock x:Name="Verdict" FontFamily="{DynamicResource UiFont}" FontSize="12.5"
                           Foreground="{DynamicResource DimBrush}" TextWrapping="Wrap" Text=""/>
            </Border>

            <!-- ações -->
            <Border Grid.Row="5" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{DynamicResource TermButton}" x:Name="StartBtn"
                            Click="Start_Click"/>
                    <Button Style="{DynamicResource TermButton}" x:Name="DoneBtn"
                            Click="Done_Click" IsEnabled="False"/>
                    <Button Style="{DynamicResource TermButton}" x:Name="CloseBtn"
                            Click="Close_Click"/>
                    <TextBlock x:Name="Elapsed" VerticalAlignment="Center" Margin="16,0,0,0"
                               FontFamily="{DynamicResource MonoFont}" FontSize="12"
                               Foreground="{DynamicResource FaintBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
