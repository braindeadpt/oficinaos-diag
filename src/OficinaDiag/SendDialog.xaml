<Window x:Class="OficinaDiag.SendDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Send to shop" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource FgBrush}"
        FontFamily="{DynamicResource UiFont}">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimBrush}"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="CaretBrush" Value="{DynamicResource FgBrush}"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource TermButton}"/>
    </Window.Resources>
    <StackPanel Margin="20">
        <TextBlock x:Name="HeaderText" FontSize="14" Foreground="{DynamicResource FgBrush}"
                   Margin="0,0,0,4"/>
        <TextBlock x:Name="DescText" TextWrapping="Wrap" Margin="0,0,0,4"/>

        <TextBlock x:Name="CodeLabel"/>
        <TextBox x:Name="ShopCodeBox" MaxLength="8" CharacterCasing="Upper"/>

        <TextBlock x:Name="NameLabel"/>
        <TextBox x:Name="NameBox" MaxLength="200"/>

        <TextBlock x:Name="PhoneLabel"/>
        <TextBox x:Name="PhoneBox" MaxLength="50"/>

        <TextBlock x:Name="EmailLabel"/>
        <TextBox x:Name="EmailBox" MaxLength="200"/> <!-- = IntakeRules.EmailMaxLength -->

        <TextBlock x:Name="PurposeLabel"/>
        <RadioButton x:Name="PurposeRepair" IsChecked="True" Foreground="{DynamicResource FgBrush}"
                     Margin="0,2,0,0"/>
        <RadioButton x:Name="PurposeSale" Foreground="{DynamicResource FgBrush}"
                     Margin="0,4,0,0"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SendBtn" IsDefault="True" Click="Send_Click"/>
            <Button x:Name="CancelBtn" IsCancel="True" Margin="10,0,0,0"/>
        </StackPanel>
    </StackPanel>
</Window>
