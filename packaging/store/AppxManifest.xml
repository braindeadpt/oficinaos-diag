<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build of OficinaOS Diag.

  Identity values below come from Partner Center → OficinaOS Diag →
  "Identidade do Produto" (Store ID 9P2BM91SFKFM). If the app is ever
  re-reserved under a different account, update them from the new
  "App identity" page before packaging (see docs/microsoft-store.md).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 rescap">

  <Identity
    Name="PedroPovoas.OficinaOSDiag"
    Publisher="CN=9DE6B7C0-63A2-4A16-870C-7EABA33F242F"
    Version="0.1.9.0" />

  <Properties>
    <DisplayName>OficinaOS Diag</DisplayName>
    <PublisherDisplayName>Pedro Povoas</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.17763.0"
      MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="pt-PT" />
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application
      Id="OficinaDiag"
      Executable="OficinaDiag.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="OficinaOS Diag"
        Description="Diagnostico de telemoveis por USB — bateria, ecra, sensores, armazenamento."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Spawns bundled adb.exe (platform-tools) and runs WPF unpackaged-style. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Cloud upload (send-to-shop, AI reports, update check). -->
    <Capability Name="internetClient" />
    <!-- Serves the on-device screen/touch test page on the shop/home LAN. -->
    <Capability Name="privateNetworkClientServer" />
  </Capabilities>
</Package>
